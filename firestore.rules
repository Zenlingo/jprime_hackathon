rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Helper: check if the caller has the 'admin' custom claim
    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    // Sessions — public read, admin write
    match /sessions/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Speakers — public read, admin write
    match /speakers/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Tracks — public read, admin write
    match /tracks/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Config — public read, admin write
    match /config/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Q&A questions — open read/write (existing behavior)
    match /questions/{doc} {
      allow read, write: if true;
    }
  }
}
